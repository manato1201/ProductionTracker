# コピーして .env を作る(.env は Git に入れない)。docker compose up だけでも既定値で起動する(ローカル開発専用)。

# --- ポート(他のツールと衝突するときに変える。Hub の使用状況を見て未使用のものを選ぶ) ---
WEB_PORT=8000
FRONTEND_PORT=5173

# --- Django ---
# 公開する環境では必ず強い値に変える。DJANGO_DEBUG=0 で SECRET_KEY が空だと起動しない。
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Cloudflare Tunnel など外部のホスト名で使うとき(カンマ区切り)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,web
DJANGO_CSRF_TRUSTED_ORIGINS=
# https の背後で動かすとき 1 にする(Secure クッキー / X-Forwarded-Proto を信頼)
DJANGO_SECURE_COOKIES=0
DJANGO_BEHIND_PROXY=0

# --- DB ---
POSTGRES_DB=productiontracker
POSTGRES_USER=productiontracker
POSTGRES_PASSWORD=change-me-too

# --- 初回起動で作る管理者(任意) ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=

# --- 取り込み API の鍵(X-API-Key)。カンマ区切りで複数可。空なら取り込みは常に 401 ---
INGEST_API_KEYS=

# --- 設定 ---
REQUIRE_VERSION_FOR_COMPLETION=1
RETURN_TASK_ON_VERSION_REJECT=0

# --- Sentry(DSN が空なら無効)---
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_SAMPLE_RATE=1.0
SENTRY_DEBUG_ENDPOINT_ENABLED=0
VITE_SENTRY_DSN=
VITE_SENTRY_DEBUG=0

# --- フロント(Vite 開発サーバー)---
# Tunnel 経由で開くときのホスト名(カンマ区切り)
VITE_ALLOWED_HOSTS=
